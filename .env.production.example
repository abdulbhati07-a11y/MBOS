# =============================================================================
# MBOS — Production Environment Variables
#
# Copy this file to `.env.production` (it is gitignored) and fill in real
# values. The defaults shown below are the **production** defaults — they
# point at Supabase and assume HTTPS in front of the stack.
#
# For a fully-local development stack, override DATABASE_URL with
# `postgresql://mbos:mbos@db:5432/mbos?schema=public` and start compose
# with `docker compose --profile local-db up`. The compose file documents
# both modes; this file is the env side of the same story.
#
# Generate secrets with the one-liners in the comments. Never commit the
# populated file. Never reuse a secret across environments.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase
#
# The backend in a single container is long-lived, so the **direct**
# connection (port 5432) is the right default. `?sslmode=require` is
# required by Supabase; the node-postgres driver (via `@prisma/adapter-pg`)
# honours it. Use the same URL for `prisma migrate deploy`.
#
# If you ever run this backend in a serverless or bursty environment,
# switch to the Supabase **transaction-mode pooler** (port 6543) and
# add `?pgbouncer=true&connection_limit=1` — the limit prevents Prisma
# from trying to multiplex statements over a single transaction-mode
# slot. Session mode does not work with Prisma's connection lifecycle.
#
# Find both URLs in the Supabase dashboard: Project Settings → Database
# → Connection string. The placeholder values below are the format
# Supabase uses, not real credentials.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# JWT secrets — 64 random bytes hex-encoded (128 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# The two secrets MUST be different. Refresh tokens are signed with the
# refresh secret; rotating it invalidates every issued refresh token and
# forces every user to re-authenticate — by design.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="REPLACE_WITH_64_BYTE_RANDOM_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX"

# -----------------------------------------------------------------------------
# JWT expiry
# -----------------------------------------------------------------------------
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV="production"

# -----------------------------------------------------------------------------
# CORS — comma-separated allow-list of browser origins that may call the
# API with credentials. The default localhost is for dev only; production
# MUST set this to the deployed frontend origin(s) or boot-time env
# validation (backend/src/config/env-validation.ts) refuses to start.
#
# Example: CORS_ORIGIN="https://app.yourdomain.com"
# -----------------------------------------------------------------------------
CORS_ORIGIN="https://app.yourdomain.com"

# -----------------------------------------------------------------------------
# Trust proxy — how Express derives the client IP behind a proxy. The
# per-IP rate limits (DEBT-013) are only sound if req.ip is unforgeable.
#   "loopback"   — trust only the compose-internal proxy (compose default)
#   "<cidr>,..." — trust X-Forwarded-For only from these hops
#   "<n>"        — trust n proxy hops (nearest-hop count)
# "true" is REFUSED by the backend — it would trust any client's
# X-Forwarded-For.
# -----------------------------------------------------------------------------
TRUST_PROXY="loopback"

# -----------------------------------------------------------------------------
# Rate limiting
# Defaults are in backend/src/rate-limit/rate-limit.config.ts; only set
# these to override. Set RATE_LIMIT_ENABLED="false" to disable (not
# recommended in production).
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"

# -----------------------------------------------------------------------------
# Password reset (DEBT-015). The TTL bounds how long a reset link is
# redeemable for; default 1 hour. Increase for a population that may
# take longer to act on the email.
# -----------------------------------------------------------------------------
RESET_TOKEN_TTL_HOURS=1

# -----------------------------------------------------------------------------
# Mail transport (DEBT-015). With SMTP_HOST set, real mail goes out
# through nodemailer; without it, the console stub is used (no delivery,
# log records that a reset WOULD have been sent — the token is never
# logged). Set these in production.
#
#   SMTP_HOST   — e.g. smtp.postmarkapp.com
#   SMTP_PORT   — 587 for STARTTLS, 465 for implicit TLS
#   SMTP_SECURE — "true" for port 465, otherwise STARTTLS upgrades
#   SMTP_USER / SMTP_PASS — omit for an unauthenticated relay
#   SMTP_FROM   — required when SMTP_HOST is set
#   PASSWORD_RESET_URL — base URL of the frontend reset page; the token
#                        is appended as ?token=…
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MBOS <no-reply@yourdomain.com>"
PASSWORD_RESET_URL="https://app.yourdomain.com/reset-password"

# -----------------------------------------------------------------------------
# Seed guard. In production the dev tenant (owner@dev.local, public
# password) MUST be skipped. Setting SEED_DEV_TENANT="false" is belt-and-
# braces: NODE_ENV=production already gates it, but a staging run with
# NODE_ENV unset can still be protected.
# -----------------------------------------------------------------------------
SEED_DEV_TENANT="false"

# -----------------------------------------------------------------------------
# AI features (FR-AI-01, FR-AI-03; NFR-11 — see backend/src/ai/).
# Both features are OFF until AI_API_KEY is set; the app is fully usable
# without them (no-op provider binding). All AI calls go through
# AIProviderInterface — the key never reaches feature code.
#
#   AI_API_KEY       — provider API key. Unset = Smart Search falls back
#                      to plain text matching; Dashboard insights render
#                      the deterministic score without AI prose.
#   AI_API_BASE_URL  — OpenAI-compatible base URL (default
#                      https://api.openai.com/v1). Points at a gateway or
#                      a self-hosted server (e.g. Ollama) without code
#                      changes.
#   AI_EMBEDDING_MODEL — default text-embedding-3-small. NOTE: the
#                      pgvector column is sized to this model's 1536
#                      dimensions (DEBT-035). Changing the model means a
#                      new migration + full catalogue re-embed.
#   AI_CHAT_MODEL    — default gpt-4o-mini; writes only the one-sentence
#                      insight prose over already-computed aggregates.
#
# FR-AI-02 disclosure: enabling a transmitting provider sends tenant
# data outbound — product name/SKU/category for embeddings, business
# aggregates (counts and money totals, never customer PII) for insights.
# That egress is a deliberate, documented part of these features.
# -----------------------------------------------------------------------------
# AI_API_KEY=""
# AI_API_BASE_URL="https://api.openai.com/v1"
# AI_EMBEDDING_MODEL="text-embedding-3-small"
# AI_CHAT_MODEL="gpt-4o-mini"

# -----------------------------------------------------------------------------
# Next 16 frontend build args
#
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY is a base64-encoded 32-byte key
# Next uses to encrypt Server Function closures before they leave the
# server. Set a STABLE value per environment so a rolling deploy does
# not invalidate in-flight Server Actions (see node_modules/next/dist/
# docs/01-app/02-guides/self-hosting.md §"Server Functions encryption
# key"). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# NEXT_PUBLIC_API_URL is the origin the browser calls. It is inlined
# into the JS at build time, so the same image cannot serve two
# different APIs; rebuild per environment. Override at build time with
#   docker compose build --build-arg NEXT_PUBLIC_API_URL=https://api.yourdomain.com frontend
# or set it in this file for a default-URL build.
# -----------------------------------------------------------------------------
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# -----------------------------------------------------------------------------
# Boot-time env validation escape hatch
# Set "true" ONLY for a staging environment that intentionally runs the
# production build over plain HTTP (the secure-cookie flag then drops
# the HTTPS requirement). Never set "true" in real production.
# -----------------------------------------------------------------------------
ALLOW_INSECURE_ENV="false"
