node_modules
# Keep environment variables out of version control
.env

# Build output (nest build → dist). Regenerated from source.
/dist

# Test coverage reports (jest --coverage).
/coverage

# TypeScript incremental build info.
*.tsbuildinfo

# Generated Prisma client (generator output = ../src/generated/prisma).
# Regenerated by `prisma generate`; never edited by hand, so kept out of git.
/src/generated/prisma

# AI-assistant tooling (Claude Code / Windsurf skills). Not application source:
# .claude/.windsurf hold absolute-path symlinks into .agents, and .agents/skills
# is third-party content downloaded per skills-lock.json (a regenerable cache).
# The repo root tracks none of these — keep the backend consistent.
/.claude
/.agents
/.windsurf
/skills-lock.json
