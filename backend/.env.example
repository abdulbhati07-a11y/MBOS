# =============================================================================
# MBOS Backend — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
#
# DEV DATABASE NOTE:
# The DATABASE_URL below points to a disposable development instance
# (Neon/Supabase free tier). This is scaffolding infrastructure, NOT the
# production database. Per Section 4.8 and C-05, production hosting and data
# residency have not been finalized. Do not accumulate real business or tenant
# data in the dev instance. See docs/section-4-system-architecture.md §4.8.
# =============================================================================

# PostgreSQL connection string (Neon/Supabase for dev, managed Postgres for prod)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mbos_dev?schema=public"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-byte-random-hex"
JWT_REFRESH_SECRET="replace-with-different-64-byte-random-hex"

# JWT expiry
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV="development"

# -----------------------------------------------------------------------------
# CORS (middleware chain step 1, Section 6.2)
# Comma-separated allow-list of browser origins. Defaults to the Next.js dev
# server when unset. Credentials are always enabled because the refresh token is
# an httpOnly cookie, so this must stay an explicit list — never a wildcard.
# -----------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Rate limiting (middleware chain step 2, Section 6.1)
# All thresholds are INTERIM pending DEBT-013; these values only override the
# defaults in src/rate-limit/rate-limit.config.ts. Requests per minute.
#   AUTH_IP    — per IP on login / mfa-verify (credential-stuffing defence)
#   GLOBAL_IP  — per IP on everything else before authentication
#   TENANT     — per tenantId once authenticated
#   BURST_MULTIPLIER — short spikes allowed above the per-minute rate
# Set RATE_LIMIT_ENABLED="false" to switch limiting off (used by the test suite).
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_IP_PER_MINUTE=10
RATE_LIMIT_GLOBAL_IP_PER_MINUTE=120
RATE_LIMIT_TENANT_PER_MINUTE=300
RATE_LIMIT_BURST_MULTIPLIER=1.5

