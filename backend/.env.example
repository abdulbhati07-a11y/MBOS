# =============================================================================
# MBOS Backend — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
#
# DEV DATABASE NOTE:
# The DATABASE_URL below points to a disposable development instance
# (Neon/Supabase free tier). This is scaffolding infrastructure, NOT the
# production database. Per Section 4.8 and C-05, production hosting and data
# residency have not been finalized. Do not accumulate real business or tenant
# data in the dev instance. See docs/section-4-system-architecture.md §4.8.
# =============================================================================

# PostgreSQL connection string (Neon/Supabase for dev, managed Postgres for prod)
#
# Do NOT add `?sslmode=...`. pg-connection-string turns it into an `ssl`
# object that replaces the pinned CA below, and the app refuses to start if
# it sees one. TLS is negotiated regardless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mbos_dev?schema=public"

# Private-CA trust anchor — REQUIRED for Supabase, leave commented otherwise.
#
# Supabase's cert chains to `Supabase Root 2021 CA`, which Node does not ship;
# without pinning it the handshake fails with SELF_SIGNED_CERT_IN_CHAIN, and
# without TLS at all Supabase refuses the session (`XX000 SSL connection is
# required`). Download the cert to backend/supabase-ca.crt and point these at
# its absolute path. Setup: docs/supabase-setup.md.
#
# There is no working fallback: if the path is set but unreadable the backend
# refuses to boot rather than connect unverified. PGSSLROOTCERT is for
# psql/pg_dump — Prisma's schema engine ignores it (DEBT-040).
# DATABASE_CA_CERT_PATH="/absolute/path/to/backend/supabase-ca.crt"
# PGSSLROOTCERT="/absolute/path/to/backend/supabase-ca.crt"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-byte-random-hex"
JWT_REFRESH_SECRET="replace-with-different-64-byte-random-hex"

# JWT expiry
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV="development"

# -----------------------------------------------------------------------------
# CORS (middleware chain step 1, Section 6.2)
# Comma-separated allow-list of browser origins. Defaults to the Next.js dev
# server when unset. Credentials are always enabled because the refresh token is
# an httpOnly cookie, so this must stay an explicit list — never a wildcard.
# -----------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Rate limiting (middleware chain step 2, Section 6.1)
# Thresholds are RESOLVED (DEBT-013); these values mirror the defaults in
# src/rate-limit/rate-limit.config.ts and only need setting to override them.
# Burst is ADDITIVE: the effective ceiling per window is PER_MINUTE + BURST.
#   AUTH_IP    — per IP on login / password-reset / mfa-verify (10 + 3  = 13)
#   GLOBAL_IP  — per IP on everything else before auth        (120 + 40 = 160)
#   TENANT     — per tenantId once authenticated              (300 + 50 = 350)
# Set RATE_LIMIT_ENABLED="false" to switch limiting off (used by the test suite).
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH_IP_PER_MINUTE=10
RATE_LIMIT_AUTH_IP_BURST=3
RATE_LIMIT_GLOBAL_IP_PER_MINUTE=120
RATE_LIMIT_GLOBAL_IP_BURST=40
RATE_LIMIT_TENANT_PER_MINUTE=300
RATE_LIMIT_TENANT_BURST=50

# -----------------------------------------------------------------------------
# Trust proxy (DEBT-013) — how Express derives the client IP behind a proxy.
# The per-IP limits above depend on req.ip being unforgeable.
#   unset / "false" — trust no proxy; req.ip is the socket address (dev default)
#   "<ip-or-cidr>[,<ip-or-cidr>…]" — trust X-Forwarded-For only from these hops
#   "<n>"           — trust n proxy hops (nearest-hop count)
# "true" is intentionally REFUSED: it would trust a forged header from anyone.
# Set this to your reverse proxy's address in production.
# -----------------------------------------------------------------------------
TRUST_PROXY="false"

# -----------------------------------------------------------------------------
# Password reset (DEBT-015)
# How long a reset token stays valid. Default when unset: 1 hour.
# -----------------------------------------------------------------------------
RESET_TOKEN_TTL_HOURS=1

# -----------------------------------------------------------------------------
# Mail transport (DEBT-015)
# With SMTP_HOST set, real mail goes out through SMTP (nodemailer). Without it,
# the console stub is used: nothing is delivered, and the log records that a
# reset WOULD have been sent (the token itself is never logged).
#
#   SMTP_HOST   — smtp provider hostname, e.g. smtp.postmarkapp.com
#   SMTP_PORT   — default 587
#   SMTP_SECURE — "true" for implicit TLS (port 465); port 587 uses STARTTLS
#   SMTP_USER / SMTP_PASS — omit for an unauthenticated relay
#   SMTP_FROM   — required when SMTP_HOST is set, e.g. "MBOS <no-reply@yourdomain>"
#   PASSWORD_RESET_URL — base URL of the frontend reset page; the token is
#                        appended as ?token=…  (default http://localhost:3000/reset-password)
# -----------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="MBOS <no-reply@yourdomain.com>"
# PASSWORD_RESET_URL="https://app.yourdomain.com/reset-password"

# -----------------------------------------------------------------------------
# Dev-tenant seeding guard
# The seed's dev tenant + owner@dev.local (public password!) are skipped when
# NODE_ENV=production, or when SEED_DEV_TENANT="false". Built-in roles,
# permissions and plans always seed.
# -----------------------------------------------------------------------------
SEED_DEV_TENANT="true"

# -----------------------------------------------------------------------------
# AI features (FR-AI-01, FR-AI-03; NFR-11 — see backend/src/ai/)
# Both features are OFF until AI_API_KEY is set; the app is fully usable without
# them (no-op provider binding). All AI calls go through AIProviderInterface —
# the key never reaches feature code.
#
#   AI_API_KEY       — provider API key. Unset = Smart Search falls back to
#                      plain text matching; Dashboard insights render the
#                      deterministic score without AI prose.
#   AI_API_BASE_URL  — OpenAI-compatible base URL (default
#                      https://api.openai.com/v1). Points at a gateway or a
#                      self-hosted server (e.g. Ollama) without code changes.
#   AI_EMBEDDING_MODEL — default text-embedding-3-small. NOTE: the pgvector
#                      column is sized to this model's 1536 dimensions
#                      (migration 20260830000000). Changing the model means a
#                      new migration + full catalogue re-embed (DEBT-035).
#   AI_CHAT_MODEL    — default gpt-4o-mini; writes only the one-sentence
#                      insight prose over already-computed aggregates.
#
# FR-AI-02 disclosure: enabling a transmitting provider sends tenant data
# outbound — product name/SKU/category for embeddings, business aggregates
# (counts and money totals, never customer PII) for insights. That egress is a
# deliberate, documented part of these features.
# -----------------------------------------------------------------------------
# AI_API_KEY=""
# AI_API_BASE_URL="https://api.openai.com/v1"
# AI_EMBEDDING_MODEL="text-embedding-3-small"
# AI_CHAT_MODEL="gpt-4o-mini"

# -----------------------------------------------------------------------------
# Boot-time env validation (src/config/env-validation.ts)
# In production the server refuses to start with missing/placeholder secrets or
# a localhost-only CORS_ORIGIN. Set ALLOW_INSECURE_ENV="true" ONLY for a staging
# environment that intentionally runs the production build over plain HTTP.
# -----------------------------------------------------------------------------
ALLOW_INSECURE_ENV="false"

